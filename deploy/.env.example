# Copy to deploy/.env and inject private values using the deployment's secret manager.
APP_ORIGIN=https://review.example.com
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# Absolute paths to the existing canonical databases; both are mounted read-only.
RAG_V2_DB_PATH=/absolute/path/to/rag/data/chroma_db_v2
RAG_V3_DB_PATH=/absolute/path/to/rag/data/chroma_db_v3
HF_MODEL_CACHE_PATH=/absolute/path/to/huggingface/cache

AI_CODE_REVIEWER_PROVIDER=groq
AI_CODE_REVIEWER_FIX_PROVIDER=groq
AI_CODE_REVIEWER_RAG_VERSION=v2
AI_CODE_REVIEWER_SOURCE_SHARING_CONSENT=false
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# Optional GitHub secrets. Keep comments disabled and commit execution hard-disabled.
GITHUB_TOKEN=
GITHUB_ACTIONS_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_STATUS_TOKEN=
