FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    AI_CODE_REVIEWER_STATE_DIR=/var/lib/ai-code-reviewer \
    AI_CODE_REVIEWER_WEBHOOK_DB_PATH=/var/lib/ai-code-reviewer/github_webhook_deliveries.sqlite3

WORKDIR /app
COPY requirements.txt ./requirements.txt
RUN python -m pip install --no-cache-dir -r requirements.txt
COPY . .
RUN mkdir -p /var/lib/ai-code-reviewer /var/cache/huggingface \
    && chown -R 10001:10001 /var/lib/ai-code-reviewer /var/cache/huggingface /app

ENV HF_HOME=/var/cache/huggingface
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "mcp_server.http_api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
