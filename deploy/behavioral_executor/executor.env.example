# Install on a dedicated Linux executor host. Keep this file owner-only.
AI_CODE_REVIEWER_EXECUTOR_BIND=0.0.0.0
AI_CODE_REVIEWER_EXECUTOR_PORT=8443
AI_CODE_REVIEWER_EXECUTOR_TLS_CERT=/etc/codementor-executor/tls.crt
AI_CODE_REVIEWER_EXECUTOR_TLS_KEY=/etc/codementor-executor/tls.key
AI_CODE_REVIEWER_EXECUTOR_HMAC_KEY=replace-with-a-random-secret-of-at-least-32-bytes
AI_CODE_REVIEWER_EXECUTOR_IMAGE=registry.example/codementor-runner@sha256:replace-with-image-digest
AI_CODE_REVIEWER_EXECUTOR_CONCURRENCY=2
TMPDIR=/var/lib/codementor-executor/requests
