# ============================================================
# CRITIQUE — AI Code Reviewer  |  Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ----------------------------------------------------------
# REQUIRED: Groq API key (used ONLY for Easy/Hard classification)
# Get your key at: https://console.groq.com/keys
# ----------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# ----------------------------------------------------------
# REQUIRED: GitHub token (read + comment permissions)
# Used for fetching PR files and posting review comments.
# ----------------------------------------------------------
GITHUB_TOKEN=your_github_token_here

# ----------------------------------------------------------
# LLM Provider settings
# review_provider and fix_provider default to qwen_local.
# Change to "groq" only if you want Groq to do the full review.
# ----------------------------------------------------------
AI_CODE_REVIEWER_PROVIDER=qwen_local
AI_CODE_REVIEWER_FIX_PROVIDER=qwen_local

# Optional: Explicit consent to send source code to Groq (for review/fix tasks).
# Not needed if you keep the providers set to qwen_local above.
# AI_CODE_REVIEWER_SOURCE_SHARING_CONSENT=false

# ----------------------------------------------------------
# Local Qwen model paths (auto-detected from llm/model by default)
# Only override if you placed the model/adapter in a custom location.
# ----------------------------------------------------------
# QWEN_BASE_MODEL_ID=Qwen/Qwen2.5-Coder-3B-Instruct
# QWEN_ADAPTER_PATH=llm/model

# ----------------------------------------------------------
# PyTorch — disable TensorFlow to avoid conflicts
# ----------------------------------------------------------
USE_TF=0
USE_TORCH=1

# ----------------------------------------------------------
# REQUIRED: GitHub Actions workflow filename for candidate CI
# Used by the autocommit pipeline (G5 gate) to trigger CI on
# the candidate branch before fast-forwarding the PR branch.
# ----------------------------------------------------------
GITHUB_CANDIDATE_WORKFLOW_NAME=candidate-verification.yml

# ----------------------------------------------------------
# OPTIONAL: HMAC attestation for auto-committed patches
# Every patch committed through the staging pipeline is signed
# with HMAC-SHA256 and verified before the atomic push (G6).
# Set a 32+ character random secret here.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# ----------------------------------------------------------
CRITIQUE_HMAC_SECRET=

# Set to "1" to make HMAC verification mandatory (blocks G6 if secret is absent).
# Default "0" = soft failure (logs a warning, still allows the commit).
CRITIQUE_HMAC_REQUIRED=0
